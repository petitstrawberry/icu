## Native Scarlet static archive build. No Linux target ABI or shared loader.
GEN_DEPS.c = $(CC) -E -MM $(DEFS) $(CPPFLAGS)
GEN_DEPS.cc = $(CXX) -E -MM $(DEFS) $(CPPFLAGS) $(CXXFLAGS)
THREADSCPPFLAGS = -D_REENTRANT
LIBCPPFLAGS =
SO = so
STATIC_O = ao
STATIC_PREFIX =
STATIC_PREFIX_WHEN_USED =
LD_RPATH =
LD_RPATH_PRE =
SHAREDLIBCFLAGS =
SHAREDLIBCXXFLAGS =
SHAREDLIBCPPFLAGS =
%.$(STATIC_O): $(srcdir)/%.c
	$(call SILENT_COMPILE,$(strip $(COMPILE.c) $(STATICCPPFLAGS) $(STATICCFLAGS)) -o $@ $<)
%.$(STATIC_O): $(srcdir)/%.cpp
	$(call SILENT_COMPILE,$(strip $(COMPILE.cc) $(STATICCPPFLAGS) $(STATICCXXFLAGS)) -o $@ $<)
%.d: $(srcdir)/%.c
	$(GEN_DEPS.c) -MT $*.$(STATIC_O) -MT $@ $< > $@
%.d: $(srcdir)/%.cpp
	$(GEN_DEPS.cc) -MT $*.$(STATIC_O) -MT $@ $< > $@
